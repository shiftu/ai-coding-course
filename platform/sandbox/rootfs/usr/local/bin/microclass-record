#!/bin/sh
# 测评录屏（asciinema v2）。落盘到 /evidence，由 harvest 取走。
set -eu
OUT="${MICROCLASS_CAST:-/evidence/session.cast}"
mkdir -p "$(dirname "$OUT")"

# 已经有一份就续编号，绝不覆盖已有证据
if [ -e "$OUT" ]; then
  i=1
  while [ -e "${OUT%.cast}-$i.cast" ]; do i=$((i+1)); done
  OUT="${OUT%.cast}-$i.cast"
fi

# 终端尺寸：asciinema 读不到时会写 width:0 height:0，那样的 cast 回放是一片空白 ——
# 证据存在但没法看，比没录还糟。兜个底。
size=$(stty size 2>/dev/null || echo "")
rows=$(echo "$size" | cut -d' ' -f1)
cols=$(echo "$size" | cut -d' ' -f2)
case "${cols:-0}" in ''|0) cols=120 ;; esac
case "${rows:-0}" in ''|0) rows=32 ;; esac

export ASCIINEMA_REC=1
exec asciinema rec --quiet --idle-time-limit 3 \
  --cols "$cols" --rows "$rows" \
  --title "microclass/${MICROCLASS_STUDENT:-unknown}" \
  --command "${SHELL:-/bin/bash} -il" "$OUT"
# -il 不是 -i：**录到的 shell 必须和学员平时那个 shell 一模一样。**
# 非登录 shell 不读 /etc/profile.d，于是录屏里没有 banner、没有 card、
# 没有 microclass-config 渲染的配置 —— 证据里那个环境和交付的环境是两个东西。
# 加 -l 不会递归：上面 export 了 ASCIINEMA_REC=1，profile.d 那个 exec 有守卫。
